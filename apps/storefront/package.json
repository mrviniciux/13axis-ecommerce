{
  "name": "@13axis/storefront",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "nx run storefront:build",
    "start": "next start",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "node scripts/prisma-cli.mjs migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "node scripts/prisma-cli.mjs migrate dev --schema prisma/schema.prisma",
    "db:push": "node scripts/prisma-cli.mjs db push --schema prisma/schema.prisma",
    "db:status": "node scripts/prisma-cli.mjs migrate status --schema prisma/schema.prisma",
    "db:reset": "node scripts/prisma-cli.mjs migrate reset --schema prisma/schema.prisma",
    "db:seed": "node scripts/prisma-generate.mjs && pnpm exec ts-node --project scripts/tsconfig.seed.json scripts/seed-products.ts",
    "db:deploy": "pnpm db:migrate && pnpm db:seed",
    "vercel-build": "pnpm db:deploy && pnpm build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "^6.19.0",
    "@tanstack/react-query": "5.80.7",
    "@tanstack/react-query-devtools": "5.80.7",
    "bcryptjs": "^3.0.3",
    "next-auth": "5.0.0-beta.32",
    "recharts": "^3.10.1",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "5",
    "@types/pg": "^8.23.1",
    "prisma": "6.19.0"
  }
}
