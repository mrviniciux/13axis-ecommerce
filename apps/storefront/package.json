{
  "name": "@13axis/storefront",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "nx run storefront:build",
    "start": "next start",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:generate:mysql": "prisma generate --schema prisma/mysql/schema.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/mysql/schema.prisma",
    "db:seed": "node scripts/prisma-generate.mjs && pnpm exec ts-node --project scripts/tsconfig.seed.json scripts/seed-products.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@netlify/database": "^2.0.1",
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "next-auth": "5.0.0-beta.32",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "6.19.0"
  }
}
