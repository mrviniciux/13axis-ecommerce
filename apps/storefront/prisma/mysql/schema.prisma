// MySQL schema used for local development and self-hosted environments.
// Netlify uses prisma/schema.prisma against Netlify Database (PostgreSQL).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  INVENTORY_MANAGER
  USER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StockMovementType {
  INITIAL_STOCK
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RELEASE
  TRANSFER
  SYNC
}

enum IntegrationStatus {
  ACTIVE
  PAUSED
  ERROR
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]
  movements     StockMovement[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([role, createdAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  position  Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, position])
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  position  Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, position])
}

model Variation {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  position  Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, position])
}

model Product {
  id          String          @id @default(cuid())
  name        String          @db.VarChar(180)
  slug        String          @unique @db.VarChar(200)
  description String?         @db.Text
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId     String?
  brand       Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variationId String?
  variation   Variation?      @relation(fields: [variationId], references: [id], onDelete: SetNull)
  status      ProductStatus   @default(DRAFT)
  image       String?         @db.LongText
  variants    ProductVariant[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, categoryId])
  @@index([brandId])
  @@index([variationId])
  @@index([updatedAt])
}

model ProductVariant {
  id                String                   @id @default(cuid())
  productId         String
  sku               String                   @unique @db.VarChar(100)
  barcode           String?                  @unique @db.VarChar(100)
  label             String?                  @db.VarChar(120)
  attributes        Json?
  costPrice         Decimal                  @db.Decimal(12, 2)
  salePrice         Decimal                  @db.Decimal(12, 2)
  product           Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory         InventoryItem?
  externalMappings  ProductExternalMapping[]
  movements         StockMovement[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([productId])
}

model InventoryItem {
  id             String         @id @default(cuid())
  variantId      String         @unique
  onHand         Int            @default(0)
  reserved       Int            @default(0)
  reorderPoint   Int            @default(0)
  updatedAt      DateTime       @updatedAt
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([onHand, reorderPoint])
}

model StockMovement {
  id              String            @id @default(cuid())
  variantId       String
  actorId         String?
  type            StockMovementType
  quantity        Int
  reference       String?           @db.VarChar(180)
  note            String?           @db.VarChar(500)
  externalSource  String?           @db.VarChar(80)
  externalEventId String?           @db.VarChar(180)
  occurredAt      DateTime          @default(now())
  variant         ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actor           User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([externalSource, externalEventId])
  @@index([variantId, occurredAt])
  @@index([type, occurredAt])
}

model IntegrationChannel {
  id          String                   @id @default(cuid())
  name        String                   @db.VarChar(120)
  provider    String                   @db.VarChar(80)
  status      IntegrationStatus        @default(PAUSED)
  settings    Json?
  mappings    ProductExternalMapping[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@unique([provider, name])
  @@index([status])
}

model ProductExternalMapping {
  id                 String             @id @default(cuid())
  channelId          String
  variantId          String
  externalProductId  String             @db.VarChar(180)
  externalVariantId  String             @db.VarChar(180)
  externalSku        String?            @db.VarChar(100)
  lastSyncedAt       DateTime?
  lastSyncError      String?            @db.Text
  channel            IntegrationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  variant            ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([channelId, variantId])
  @@unique([channelId, externalVariantId])
  @@index([externalProductId])
}