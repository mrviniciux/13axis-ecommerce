generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("NETLIFY_DB_URL")
}

enum UserRole {
  ADMIN
  INVENTORY_MANAGER
  USER

  @@map("user_role")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum StockMovementType {
  INITIAL_STOCK
  RECEIPT
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RELEASE
  TRANSFER
  SYNC

  @@map("stock_movement_type")
}

enum IntegrationStatus {
  ACTIVE
  PAUSED
  ERROR

  @@map("integration_status")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String? @map("password_hash")
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]
  movements     StockMovement[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([role, createdAt])

  @@map("user")
}

model Account {
  userId            String @map("user_id")
  type              String
  provider          String
  providerAccountId String @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])

  @@map("account")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])

  @@map("verification_token")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  position  Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([active, position])

  @@map("category")
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  position  Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([active, position])

  @@map("brand")
}

model Variation {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  position  Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([active, position])

  @@map("variation")
}

model Product {
  id          String          @id @default(cuid())
  name        String          @db.VarChar(180)
  slug        String          @unique @db.VarChar(200)
  description String?         @db.Text
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId     String?
  brand       Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variationId String?
  variation   Variation?      @relation(fields: [variationId], references: [id], onDelete: SetNull)
  status      ProductStatus   @default(DRAFT)
  image       String?         @db.Text
  variants    ProductVariant[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, categoryId])
  @@index([brandId])
  @@index([variationId])
  @@index([updatedAt])
}

model ProductVariant {
  id                String                   @id @default(cuid())
  productId         String @map("product_id")
  sku               String                   @unique @db.VarChar(100)
  barcode           String?                  @unique @db.VarChar(100)
  label             String?                  @db.VarChar(120)
  attributes        Json?
  costPrice         Decimal                  @db.Decimal(12, 2) @map("cost_price")
  salePrice         Decimal                  @db.Decimal(12, 2) @map("sale_price")
  product           Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory         InventoryItem?
  externalMappings  ProductExternalMapping[]
  movements         StockMovement[]
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  @@index([productId])

  @@map("product_variant")
}

model InventoryItem {
  id             String         @id @default(cuid())
  variantId      String         @unique @map("variant_id")
  onHand         Int            @default(0) @map("on_hand")
  reserved       Int            @default(0)
  reorderPoint   Int            @default(0) @map("reorder_point")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([onHand, reorderPoint])

  @@map("inventory_item")
}

model StockMovement {
  id              String            @id @default(cuid())
  variantId       String @map("variant_id")
  actorId         String? @map("actor_id")
  type            StockMovementType
  quantity        Int
  reference       String?           @db.VarChar(180)
  note            String?           @db.VarChar(500)
  externalSource  String?           @db.VarChar(80) @map("external_source")
  externalEventId String?           @db.VarChar(180) @map("external_event_id")
  occurredAt      DateTime          @default(now()) @map("occurred_at")
  variant         ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actor           User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([externalSource, externalEventId])
  @@index([variantId, occurredAt])
  @@index([type, occurredAt])

  @@map("stock_movement")
}

model IntegrationChannel {
  id          String                   @id @default(cuid())
  name        String                   @db.VarChar(120)
  provider    String                   @db.VarChar(80)
  status      IntegrationStatus        @default(PAUSED)
  settings    Json?
  mappings    ProductExternalMapping[]
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  @@unique([provider, name])
  @@index([status])

  @@map("integration_channel")
}

model ProductExternalMapping {
  id                 String             @id @default(cuid())
  channelId          String @map("channel_id")
  variantId          String @map("variant_id")
  externalProductId  String             @db.VarChar(180) @map("external_product_id")
  externalVariantId  String             @db.VarChar(180) @map("external_variant_id")
  externalSku        String?            @db.VarChar(100) @map("external_sku")
  lastSyncedAt       DateTime? @map("last_synced_at")
  lastSyncError      String?            @db.Text @map("last_sync_error")
  channel            IntegrationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  variant            ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@unique([channelId, variantId])
  @@unique([channelId, externalVariantId])
  @@index([externalProductId])

  @@map("product_external_mapping")
}