{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "storefront",
  "projectType": "application",
  "sourceRoot": "apps/storefront/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev",
        "cwd": "apps/storefront"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/storefront"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start",
        "cwd": "apps/storefront"
      },
      "dependsOn": ["build"],
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src e2e .storybook next.config.mjs jest.config.ts playwright.config.ts --ext .js,.jsx,.ts,.tsx,.mjs",
        "cwd": "apps/storefront"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config jest.config.ts",
        "cwd": "apps/storefront"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "jest --config jest.config.ts --watch",
        "cwd": "apps/storefront"
      },
      "cache": false
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test --project=chromium",
        "cwd": "apps/storefront"
      },
      "cache": false
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/storefront"
      }
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook dev --config-dir .storybook -p 6006",
        "cwd": "apps/storefront"
      },
      "cache": false
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "storybook build --config-dir .storybook",
        "cwd": "apps/storefront"
      }
    }
  }
}
