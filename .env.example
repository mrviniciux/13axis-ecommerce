MYSQL_DATABASE=axis_store
MYSQL_USER=axis_admin
MYSQL_PASSWORD=change-this-local-password
MYSQL_ROOT_PASSWORD=change-this-local-root-password
MYSQL_PORT=3306

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional locally; set to the intended admin email in production.
ADMIN_EMAIL=

# Full database URL for Prisma. Docker Compose builds this from MYSQL_* variables.
DATABASE_URL=mysql://axis_admin:change-this-local-password@127.0.0.1:3306/axis_store

# Local development uses MySQL. Netlify sets this to postgresql and provides
# NETLIFY_DB_URL automatically through Netlify Database.
DATABASE_PROVIDER=mysql

# Optional. Google callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=