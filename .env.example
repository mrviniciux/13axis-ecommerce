# PostgreSQL used by Prisma and the application.
DATABASE_URL=postgresql://axis_admin:change-this-local-password@127.0.0.1:5432/axis_store

# Docker Compose PostgreSQL service. Keep these aligned with DATABASE_URL.
POSTGRES_DB=axis_store
POSTGRES_USER=axis_admin
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional locally; set to the intended admin email in production.
ADMIN_EMAIL=

# Optional Google OAuth. Callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel's Prisma Postgres integration can inject POSTGRES_PRISMA_DATABASE_URL
# or POSTGRES_URL instead of DATABASE_URL. The app accepts both as fallbacks.
